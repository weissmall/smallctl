{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i -E 's/version = \"[^\"]+\";/version = \"${nextRelease.version}\";/' flake.nix"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["flake.nix"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\\n\\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/smallctl-linux-amd64",
            "name": "smallctl-${nextRelease.version}-amd64",
            "label": "smallctl for amd64"
          },
          {
            "path": "dist/smallctl-linux-arm64",
            "name": "smallctl-${nextRelease.version}-arm64",
            "label": "smallctl for arm64"
          }
        ]
      }
    ]
  ]
}
